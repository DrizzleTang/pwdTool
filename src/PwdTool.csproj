<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PwdTool</AssemblyName>
    <RootNamespace>PwdTool</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <!-- 生成单文件可执行程序时使用: dotnet publish -c Release -r win-x64 -->

    <!-- 与 app.manifest 中的 dpiAwareness=PerMonitorV2 保持一致声明；
         真正生效的是 manifest（进程启动前由系统读取），这里显式写出只是为了避免歧义，
         ApplicationConfiguration.Initialize() 生成的 Application.SetHighDpiMode 调用
         在 manifest 已声明的情况下会被系统忽略，不会产生冲突。 -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>

    <!-- 允许在非 Windows 主机上构建/发布面向 Windows 的项目（交叉编译生成 win-x64 可执行文件用）。
         在 Windows 上构建时这个开关本就无影响。 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- 项目里字符串比较统一用 OrdinalIgnoreCase，日期都按 UTC 处理，不依赖任何文化相关的
         排序/格式化逻辑，开启 InvariantGlobalization 在这里是无风险的，可以减小自包含单文件
         发布体积、加快启动速度。 -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- 已开启 Nullable，但默认只是警告级别；配合当前没有 CI 的现状，容易在后续开发中悄悄
         引入空引用警告而不自知。把可空性警告提升为编译错误，保证"0 警告 0 错误"这个当前
         状态不会被后续改动悄悄破坏。 -->
    <WarningsAsErrors>Nullable</WarningsAsErrors>

    <!-- PublishTrimmed/PublishReadyToRun 经评估后暂不启用：项目虽已改用 System.Text.Json
         源生成上下文(JsonContext.cs)降低了裁剪风险，但本仓库的开发环境是 Linux 沙箱、
         无法在真实 Windows 上跑一遍发布产物验证裁剪后功能是否完好，贸然开启裁剪一旦出问题
         (例如某个未被覆盖到的反射调用)会比"体积大一点"更糟。留给使用者在有 Windows
         测试条件时自行评估开启：<PublishTrimmed>true</PublishTrimmed> +
         <TrimMode>partial</TrimMode> + <PublishReadyToRun>true</PublishReadyToRun>。 -->
  </PropertyGroup>

  <ItemGroup>
    <!-- 用于读取 Chrome/Edge 的 Login Data (SQLite) -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.7" />
    <!-- DPAPI 数据保护 (ProtectedData) -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
